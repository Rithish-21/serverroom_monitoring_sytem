# Server Room Environment Monitoring - Environment Configuration

# Server Config
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=server_room_monitoring

# JWT Authentication
JWT_SECRET=sentinel_datacenter_secure_jwt_token_secret_key_2025
JWT_EXPIRES_IN=24h

# Admin Portal Registration Secret Code
ADMIN_INVITE_CODE=ADMIN_DC_SECURE_2025

# Email OTP Service (Nodemailer)
# (If not configured or credentials invalid, OTPs are safely logged to the server console)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=datacenter.alerts@example.com
EMAIL_PASS=your_email_app_password
EMAIL_FROM="SentinelCore Monitoring <datacenter.alerts@example.com>"

# Phone OTP Service (Twilio)
# (If not configured or mock values used, SMS OTPs are safely logged to the server console)
TWILIO_ACCOUNT_SID=AC_sample_twilio_sid_here
TWILIO_AUTH_TOKEN=sample_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+12025550100
